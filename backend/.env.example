PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE_NAME?schema=public"

JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REFRESH_TOKEN_COOKIE_NAME=travora_refresh_token
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000
# Must be true when NODE_ENV=production (startup fails otherwise).
COOKIE_SECURE=false
# strict | lax | none -- "none" requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=strict

# --- Session hardening (CR-012); the values below are the defaults ---

# Absolute session lifetime from login (30 days); refreshing never extends it.
SESSION_ABSOLUTE_MAX_AGE_MS=2592000000
# How long the token replaced by the latest rotation gets a 409 instead of
# reuse revocation (concurrent tabs / in-flight responses). 0 disables.
REFRESH_REUSE_GRACE_MS=10000

# CR-033 staged rollout: issuance only; validation must never depend on this flag.
# Enable only after migration/client generation and ALL backend instances support v2.
# Stage 2 supplies backend recovery; browser recovery UX validation remains Stage 3.
AUTH_BOUND_SESSIONS_ENABLED=false
# BOTH key settings are REQUIRED at startup, even when issuance is disabled.
# Provision dedicated keys before starting this CR-033-compatible backend.
# JSON object: key IDs (1-32 A-Z/a-z/0-9/_/-) -> canonical padded base64, exactly 32 bytes.
# AUTH_REFRESH_RECOVERY_KEYS={"key-id":"<provision-a-dedicated-32-byte-base64-key>"}
# AUTH_REFRESH_RECOVERY_ACTIVE_KEY_ID=key-id
# Never reuse JWT or booking-confirmation secrets. Retain old decryption keys
# until all unexpired recovery windows have closed and old encryptors have drained.

# Leave empty unless the API runs behind a reverse proxy. Allowed: a hop
# count (1-10) or a comma-separated list of loopback/linklocal/uniquelocal,
# IP addresses or CIDR subnets. "true" and catch-all values are rejected.
TRUST_PROXY=

# Auth rate limiting (in-memory, per backend process).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Failed logins per client IP + email within the window.
AUTH_RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# Failed logins per client IP (any email) within the window.
AUTH_RATE_LIMIT_LOGIN_IP_MAX=30
AUTH_RATE_LIMIT_REGISTER_WINDOW_MS=900000
AUTH_RATE_LIMIT_REGISTER_MAX=30
AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=60000
AUTH_RATE_LIMIT_REFRESH_MAX=120

# Booking lifecycle confirmation codes (CR-032): HMAC key for the traveler's
# tour start/complete codes. Required, at least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-side only. Never commit a real value.
BOOKING_CONFIRMATION_SECRET=replace-with-at-least-32-random-characters
