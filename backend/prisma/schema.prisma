generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TOURIST
  ADMIN
  TOUR_GUIDE
  SYSTEM_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum TourRequestType {
  PACKAGE_BASED
  CUSTOM
}

enum TourRequestStatus {
  PENDING_REVIEW
  UNDER_DISCUSSION
  READY_FOR_QUOTATION
  QUOTATION_SENT
  ACCEPTED
  REJECTED
  CANCELLED
  BOOKED
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model TourRequest {
  id               String  @id @default(uuid()) @db.Uuid
  touristId        String  @map("tourist_id") @db.Uuid
  packageId        Int?    @map("package_id")
  preferredGuideId String? @map("preferred_guide_id") @db.Uuid
  assignedAdminId  String? @map("assigned_admin_id") @db.Uuid

  requestType TourRequestType @map("request_type")
  title       String?         @db.VarChar(200)

  preferredStartDate DateTime          @map("preferred_start_date") @db.Date
  preferredEndDate   DateTime?         @map("preferred_end_date") @db.Date
  preferredGuide     TourGuideProfile? @relation("PreferredGuideRequests", fields: [preferredGuideId], references: [id], onDelete: SetNull)

  adultCount Int @default(1) @map("adult_count")
  childCount Int @default(0) @map("child_count")

  destinationPreferences String?  @map("destination_preferences")
  budget                 Decimal? @db.Decimal(12, 2)
  currency               String   @default("USD") @db.VarChar(10)

  hotelPreference     String? @map("hotel_preference") @db.VarChar(100)
  transportPreference String? @map("transport_preference") @db.VarChar(100)
  specialRequirements String? @map("special_requirements")

  contactMethod ContactMethod?    @map("contact_method")
  status        TourRequestStatus @default(PENDING_REVIEW)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tourist       User           @relation("TourRequestTourist", fields: [touristId], references: [id], onDelete: Restrict)
  travelPackage TravelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  quotations TourQuotation[]

  @@index([touristId])
  @@index([packageId])
  @@index([preferredGuideId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([requestType])
  @@index([preferredStartDate])
  @@map("tour_requests")
}

model TravelPackage {
  id           Int       @id @default(autoincrement())
  title        String
  slug         String    @unique
  destination  String
  description  String
  durationDays Int
  price        Decimal   @db.Decimal(10, 2)
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? @map("deleted_at")

  tourRequests TourRequest[]

  images      PackageImage[]
  itineraries PackageItinerary[]
  inclusions  PackageInclusion[]
  exclusions  PackageExclusion[]
  faqs        PackageFAQ[]

  @@index([status])
  @@index([deletedAt])
  @@map("travel_packages")
}

model PackageImage {
  id           Int      @id @default(autoincrement())
  packageId    Int
  imageUrl     String
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([isPrimary])
  @@map("package_images")
}

model PackageItinerary {
  id          Int      @id @default(autoincrement())
  packageId   Int
  dayNumber   Int
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_itineraries")
}

model PackageInclusion {
  id        Int      @id @default(autoincrement())
  packageId Int
  title     String
  createdAt DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_inclusions")
}

model PackageExclusion {
  id        Int      @id @default(autoincrement())
  packageId Int
  title     String
  createdAt DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_exclusions")
}

model PackageFAQ {
  id           Int      @id @default(autoincrement())
  packageId    Int
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_faqs")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  email           String       @unique @db.VarChar(255)
  phone           String?      @db.VarChar(30)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  role            UserRole     @default(TOURIST)
  provider        AuthProvider @default(LOCAL)
  providerId      String?      @map("provider_id") @db.VarChar(255)
  profileImageUrl String?      @map("profile_image_url")
  isEmailVerified Boolean      @default(false) @map("is_email_verified")
  status          UserStatus   @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tourRequests     TourRequest[]     @relation("TourRequestTourist")
  tourGuideProfile TourGuideProfile?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@unique([provider, providerId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @unique @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceName String?   @map("device_name") @db.VarChar(150)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.Text
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model TourGuideProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bio             String?
  experienceYears Int       @default(0) @map("experience_years")
  languages       String[]
  specializations String[]
  location        String?   @db.VarChar(150)
  dailyRate       Decimal?  @map("daily_rate") @db.Decimal(12, 2)
  averageRating   Decimal   @default(0) @map("average_rating") @db.Decimal(3, 2)
  totalReviews    Int       @default(0) @map("total_reviews")
  isAvailable     Boolean   @default(true) @map("is_available")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  preferredTourRequests TourRequest[]   @relation("PreferredGuideRequests")
  quotations            TourQuotation[]

  @@index([location])
  @@index([isAvailable])
  @@map("tour_guide_profiles")
}

model TourQuotation {
  id            String  @id @default(uuid()) @db.Uuid
  tourRequestId String  @map("tour_request_id") @db.Uuid
  guideId       String? @map("guide_id") @db.Uuid

  quotationNumber String @unique @map("quotation_number") @db.VarChar(50)
  revisionNumber  Int    @default(1) @map("revision_number")

  title       String  @db.VarChar(200)
  description String?

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  adultCount Int @map("adult_count")
  childCount Int @default(0) @map("child_count")

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(12, 2)
  currency       String  @default("USD") @db.VarChar(10)

  notes           String?
  termsConditions String? @map("terms_conditions")

  validUntil DateTime?       @map("valid_until")
  status     QuotationStatus @default(DRAFT)

  sentAt      DateTime? @map("sent_at")
  respondedAt DateTime? @map("responded_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tourRequest TourRequest       @relation(fields: [tourRequestId], references: [id], onDelete: Restrict)
  guide       TourGuideProfile? @relation(fields: [guideId], references: [id], onDelete: SetNull)

  itineraries QuotationItinerary[]
  inclusions  QuotationInclusion[]
  exclusions  QuotationExclusion[]

  @@unique([tourRequestId, revisionNumber])
  @@index([tourRequestId])
  @@index([guideId])
  @@index([status])
  @@index([validUntil])
  @@map("tour_quotations")
}

model QuotationItinerary {
  id          Int    @id @default(autoincrement())
  quotationId String @map("quotation_id") @db.Uuid

  dayNumber   Int
  title       String @db.VarChar(200)
  description String

  quotation TourQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, dayNumber])
  @@index([quotationId])
  @@map("quotation_itineraries")
}

model QuotationInclusion {
  id          Int    @id @default(autoincrement())
  quotationId String @map("quotation_id") @db.Uuid
  title       String

  quotation TourQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_inclusions")
}

model QuotationExclusion {
  id          Int    @id @default(autoincrement())
  quotationId String @map("quotation_id") @db.Uuid
  title       String

  quotation TourQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_exclusions")
}
