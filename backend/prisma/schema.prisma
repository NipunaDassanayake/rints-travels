generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TOURIST
  ADMIN
  TOUR_GUIDE
  SYSTEM_ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model TravelPackage {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  destination  String
  description  String
  durationDays Int
  price        Decimal  @db.Decimal(10, 2)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images      PackageImage[]
  itineraries PackageItinerary[]
  inclusions  PackageInclusion[]
  exclusions  PackageExclusion[]
  faqs        PackageFAQ[]

  @@map("travel_packages")
}

model PackageImage {
  id           Int      @id @default(autoincrement())
  packageId    Int
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_images")
}

model PackageItinerary {
  id          Int      @id @default(autoincrement())
  packageId   Int
  dayNumber   Int
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_itineraries")
}

model PackageInclusion {
  id        Int      @id @default(autoincrement())
  packageId Int
  title     String
  createdAt DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_inclusions")
}

model PackageExclusion {
  id        Int      @id @default(autoincrement())
  packageId Int
  title     String
  createdAt DateTime @default(now())

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_exclusions")
}

model PackageFAQ {
  id           Int      @id @default(autoincrement())
  packageId    Int
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  travelPackage TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_faqs")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String       @map("first_name") @db.VarChar(100)
  lastName        String       @map("last_name") @db.VarChar(100)
  email           String       @unique @db.VarChar(255)
  phone           String?      @db.VarChar(30)
  passwordHash    String?      @map("password_hash") @db.VarChar(255)
  role            UserRole     @default(TOURIST)
  provider        AuthProvider @default(LOCAL)
  providerId      String?      @map("provider_id") @db.VarChar(255)
  profileImageUrl String?      @map("profile_image_url")
  isEmailVerified Boolean      @default(false) @map("is_email_verified")
  status          UserStatus   @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@unique([provider, providerId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}
